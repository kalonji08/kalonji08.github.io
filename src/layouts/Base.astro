---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  tags?: string[];
  categories?: string[];
}

const {
  title = 'Dr. Kalonji A. Tshisekedi',
  description = 'Genomicist, computational biologist and data scientist specialising in population genomics, multi-omics, precision health, and African genetics.',
  image = '/img/1500x500.jpg',
  type = 'website',
  publishedDate,
  tags,
  categories,
} = Astro.props;

const siteTitle = 'Dr. Kalonji A. Tshisekedi';
const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content={Astro.generator}>
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>

  <meta property="og:type" content={type}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={absoluteImage}>
  <meta property="og:site_name" content={siteTitle}>
  {type === 'article' && publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()}>}
  {type === 'article' && <meta property="article:author" content="Dr. Kalonji A. Tshisekedi">}
  {type === 'article' && tags?.map(tag => <meta property="article:tag" content={tag}>)}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@kalonji_08">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={absoluteImage}>

  <link rel="alternate" type="application/rss+xml" title={siteTitle} href={new URL('/rss.xml', Astro.site)}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  {type !== 'article' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Dr. Kalonji A. Tshisekedi",
      "alternateName": ["Kalonji Tshisekedi", "Kalonji A. Tshisekedi"],
      "url": Astro.site?.href,
      "image": absoluteImage,
      "jobTitle": "Genomicist & Computational Biologist",
      "description": "Genomicist, computational biologist and data scientist specialising in population genomics, multi-omics, precision health, and African genetics.",
      "sameAs": [
        "https://github.com/kalonji08",
        "https://www.linkedin.com/in/dr-kalonji-a-tshisekedi-ph-d-2a339b76/",
        "https://twitter.com/kalonji_08"
      ],
    })} />
  )}

  {type === 'article' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "image": absoluteImage,
      "url": canonicalURL.href,
      "datePublished": publishedDate?.toISOString(),
      "author": {
        "@type": "Person",
        "name": "Dr. Kalonji A. Tshisekedi",
        "url": Astro.site?.href,
      },
      "publisher": {
        "@type": "Person",
        "name": "Dr. Kalonji A. Tshisekedi",
      },
      ...(tags?.length ? { "keywords": tags.join(', ') } : {}),
    })} />
  )}
</head>
<body>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">Dr. Kalonji A. Tshisekedi</a>
      <button class="nav-toggle" aria-label="Toggle menu" id="nav-toggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <ul class="nav-links" id="nav-links">
        <li class="nav-close-li"><button class="nav-close" aria-label="Close menu" id="nav-close">&times;</button></li>
        <li><a href="/about" class={Astro.url.pathname.startsWith('/about') ? 'active' : ''}>About</a></li>
        <li><a href="/research" class={Astro.url.pathname.startsWith('/research') ? 'active' : ''}>Research</a></li>
        <li><a href="/projects" class={Astro.url.pathname.startsWith('/projects') ? 'active' : ''}>Projects</a></li>
        <li><a href="/blog" class={Astro.url.pathname.startsWith('/blog') ? 'active' : ''}>Blog</a></li>
        <li><a href="mailto:kalonji.tshisekedi@gmail.com" class="nav-cta">Inquire</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <ul class="footer-links">
        <li><a href="/about">About</a></li>
        <li><a href="/research">Research</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/blog">Blog</a></li>
      </ul>
      <div class="footer-social">
        <a href="https://github.com/kalonji08" target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/dr-kalonji-a-tshisekedi-ph-d-2a339b76/" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://twitter.com/kalonji_08" target="_blank" rel="noopener" aria-label="X / Twitter">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      </div>
      <p class="footer-copy">&copy; {new Date().getFullYear()} Dr. Kalonji A. Tshisekedi</p>
    </div>
  </footer>

  <script>
    document.getElementById('nav-toggle')?.addEventListener('click', () => {
      document.getElementById('nav-links')?.classList.add('open');
    });
    document.getElementById('nav-close')?.addEventListener('click', () => {
      document.getElementById('nav-links')?.classList.remove('open');
    });
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
